diff --git a/arch/arm64/include/asm/kvm_pkvm_cov.h b/arch/arm64/include/asm/kvm_pkvm_cov.h
new file mode 100644
index 000000000000..6b80e4b45287
--- /dev/null
+++ b/arch/arm64/include/asm/kvm_pkvm_cov.h
@@ -0,0 +1,100 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Stage-2 EL2 coverage — shared ring layout between the pKVM hyp (producer) and
+ * the host (consumer). A physically contiguous, host-shared buffer of
+ * `nr_pages` pages: a 24-byte header on page 0 followed by PC slots that run to
+ * the end of the last page. The hyp's __sanitizer_cov_trace_pc appends EL2
+ * hyp-VA PCs; the host drains them into the current task's KCOV area via
+ * kcov_add_pcs().
+ *
+ * WHY CONTIGUOUS: kvm_share_hyp() maps into the 'fixed-offset' region of the hyp
+ * VA space and therefore walks a *physical* range derived from the virtual one
+ * (mmu.c), and the hyp pins the same range off a single PFN. So contiguity is a
+ * requirement of THIS pfn+range design, not a fundamental one — a scatter-gather
+ * mapping would lift it, and is deliberately out of scope here.
+ *
+ * LOSS ACCOUNTING (Step 1B). `count` alone cannot answer "how much did we lose":
+ * once the buffer is full the producer stops incrementing it, so a full buffer
+ * looks identical whether one PC or ten thousand were discarded. The header
+ * therefore also carries per-#23 producer counters (hits/dropped/nested) that
+ * keep counting past the truncation point.
+ */
+#ifndef __ASM_KVM_PKVM_COV_H
+#define __ASM_KVM_PKVM_COV_H
+
+#include <linux/types.h>
+
+/*
+ * Bounds on the host-supplied page count. The host is NOT trusted by the hyp, so
+ * __pkvm_cov_setup() validates nr_pages against these before pinning anything:
+ * an unbounded value would mean an unbounded pin range and loop at EL2.
+ * Must be a power of two so the host can back it with a single order-N allocation.
+ */
+#define PKVM_COV_MAX_PAGES	16
+#define PKVM_COV_DEFAULT_PAGES	4
+
+#define PKVM_COV_HDR_BYTES	24
+
+/* flags: a single u32. */
+#define PKVM_COV_FLAG_ENABLED  (1u << 0)	/* host-set: collect on this CPU */
+#define PKVM_COV_FLAG_OVERFLOW (1u << 1)	/* hyp-set: buffer filled, PCs dropped */
+
+struct pkvm_cov_ring {
+	__u32 count;			/* number of valid entries in pcs[] (hyp-written) */
+	__u32 flags;			/* PKVM_COV_FLAG_* */
+	/*
+	 * Per-#23 producer counters. Host zeroes them in pkvm_cov_begin() before
+	 * the release-set of ENABLED; hyp increments them; host snapshots them in
+	 * pkvm_cov_end() after its acquire-load of `count`.
+	 *
+	 * Publication: `hits` and `dropped` are written before the hyp's
+	 * release-store of `count` / `flags`, so the host's acquire loads expose
+	 * them. `nested` has no such pairing, and is instead published by the
+	 * EL2->EL1 ERET: the drain only ever runs on the buffer's owner CPU (the
+	 * owner guard in pkvm_cov_begin() returns false otherwise), so producer and
+	 * consumer are the same PE and the exception return is a context
+	 * synchronization event. A future per-CPU / cross-CPU buffer MUST replace
+	 * this with an explicit release.
+	 */
+	__u32 hits;			/* armed SanCov callbacks entered, this #23 */
+	__u32 dropped;			/* of those, discarded because the buffer was full */
+	__u32 nested;			/* callbacks discarded by the recursion guard */
+	/*
+	 * PC slots in pcs[]. Written ONCE by the host at setup, before the buffer
+	 * pointer is published, and only ever read by the host — reached through
+	 * the same pointer, so the address dependency orders it with no extra
+	 * barrier. The hyp does NOT read this field: it derives its own bound from
+	 * the nr_pages it validated and pinned, so a corrupted header can never
+	 * make the producer write outside the pinned range.
+	 */
+	__u32 capacity;
+	__u64 pcs[];			/* EL2 hyp-VA program counters */
+};
+
+_Static_assert(sizeof(struct pkvm_cov_ring) == PKVM_COV_HDR_BYTES,
+	       "pkvm_cov_ring header must stay PKVM_COV_HDR_BYTES with pcs[] flexible");
+
+/* PC slots available in an nr_pages buffer. 1 page -> 509, 4 pages -> 2045. */
+static inline __u32 pkvm_cov_capacity_for(__u32 nr_pages)
+{
+	return (nr_pages * PAGE_SIZE - PKVM_COV_HDR_BYTES) / sizeof(__u64);
+}
+
+#ifndef __KVM_NVHE_HYPERVISOR__
+/*
+ * Host (EL1) drain side — arch/arm64/kvm/pkvm_cov.c. Not visible to the hyp build.
+ *
+ * begin() hands back the buffer AND its capacity in one shot, so end() never has
+ * to re-read global state that a concurrent disable() could be changing.
+ */
+struct pkvm_cov_ctx {
+	struct pkvm_cov_ring *ring;
+	__u32 capacity;
+};
+
+unsigned long pkvm_cov_runtime_to_link(unsigned long pc);	/* runtime hyp-VA -> link addr, 0 if out of range */
+bool pkvm_cov_begin(struct pkvm_cov_ctx *ctx);	/* #23 hook: arm iff owner CPU + KCOV active */
+void pkvm_cov_end(struct pkvm_cov_ctx *ctx);	/* #23 hook: disarm, drain+convert PCs, kcov_add_pcs() */
+#endif
+
+#endif /* __ASM_KVM_PKVM_COV_H */
