+config PKVM_EL2_COV
+	bool "pKVM EL2 (Rust hyp) coverage for syzkaller (Stage-2 KCOV)"
+	depends on KVM && X1_RMS && KCOV
+	depends on !RANDOMIZE_BASE
+	depends on !PREEMPT_RT
+	default n
+	help
+	  Instrument the protected-KVM Rust hypervisor with SanCov trace-pc and
+	  build it with DWARF line info, so EL2 program counters can be drained
+	  around a host->hyp boundary into the fuzzer task's KCOV area and
+	  symbolized to Rust source. This is a fuzzing/debug option only; it grows
+	  the hyp image and adds a per-basic-block callback. It never changes any
+	  existing hypercall id (its own id is guarded and explicitly dispatched).
+
+	  Depends on !RANDOMIZE_BASE: the drain converts a runtime hyp PC to its
+	  vmlinux link address (pkvm_cov_runtime_to_link), which only equals the
+	  offline vmlinux address when KASLR is off. With KASLR on the recovered
+	  address would not symbolize against the offline vmlinux.
+
+	  Depends on !PREEMPT_RT: the drain's teardown treats the mmu_lock-held
+	  begin->end window as an RCU read-side section (preemption disabled). On
+	  PREEMPT_RT the rwlock is a sleeping lock and does not disable preemption,
+	  so that assumption — and the single-CPU owner stability — would not hold.
+
+	  If unsure, say N.
+
 config XCORE_STATS
 	bool "X Core stats support"
 	depends on KVM
