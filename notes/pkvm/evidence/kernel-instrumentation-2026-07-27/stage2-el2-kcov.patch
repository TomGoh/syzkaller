diff --git a/arch/arm64/kvm/pkvm_cov.c b/arch/arm64/kvm/pkvm_cov.c
new file mode 100644
index 000000000000..4694af6eba70
--- /dev/null
+++ b/arch/arm64/kvm/pkvm_cov.c
@@ -0,0 +1,678 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Stage-2 EL2 coverage — host (EL1) side.
+ *
+ * The EL2 SanCov callback (hyp/nvhe/cov.c) records hyp *runtime* PCs into a
+ * host-shared per-CPU ring. This file owns the host end of that ring:
+ *
+ *   - pkvm_cov_runtime_to_link(): convert a runtime hyp PC to its vmlinux
+ *     __kvm_nvhe_ *link* address, so syzkaller/DWARF can symbolize it.
+ *   - pkvm_cov_enable()/disable(): allocate + kvm_share_hyp() the ring pages and
+ *     register/unregister them with EL2 on the owner CPU (debugfs-triggered).
+ *   - pkvm_cov_begin()/end(): the pKVM #23 (pkvm_host_map_guest) drain — arm the
+ *     ring, let EL2 fill it during the map, then convert + hand the PCs to
+ *     kcov_add_pcs() in the faulting task's KCOV area.
+ *
+ * Scope: SINGLE CPU, a configurable physically-contiguous MULTI-PAGE ring
+ * (nr_pages via debugfs, default 4). Coverage is attributed by `current` (the
+ * task whose KVM_RUN took the #23 fault), so the drain lands in exactly that
+ * task's KCOV area. Because the ring is single-CPU, KVM_RUNs on any other CPU
+ * collect nothing (owner-CPU guard below) — so this mode REQUIRES strict
+ * serialization (procs=1, no Threaded, no Collide) and the executor pinned to
+ * the owner CPU. Per-online-CPU rings (to allow controlled concurrency) are a
+ * later step.
+ */
+#include <linux/types.h>
+#include <linux/kcov.h>
+#include <linux/debugfs.h>
+#include <linux/seq_file.h>	/* stats export */
+#include <linux/string.h>	/* memset/memcpy of the stats block */
+#include <linux/bitops.h>	/* fls() for the log2 histogram */
+#include <linux/minmax.h>	/* min_t() */
+#include <linux/kvm_host.h>	/* kvm_debugfs_dir */
+#include <linux/gfp.h>
+#include <linux/mm.h>
+#include <linux/smp.h>
+#include <linux/mutex.h>
+#include <linux/printk.h>
+#include <linux/preempt.h>
+#include <linux/rcupdate.h>
+#include <asm/barrier.h>
+#include <asm/sections.h>	/* __hyp_text_start / __hyp_text_end */
+#include <asm/memory.h>		/* lm_alias */
+#include <asm/kvm_asm.h>	/* __KVM_HOST_SMCCC_FUNC___pkvm_cov_setup */
+#include <asm/kvm_host.h>	/* kvm_call_hyp_nvhe */
+#include <asm/kvm_mmu.h>	/* kern_hyp_va, kvm_share_hyp, kvm_unshare_hyp */
+#include <asm/kvm_pkvm_cov.h>
+
+/*
+ * Convert an EL2 hyp runtime PC to its vmlinux __kvm_nvhe_* link address.
+ *
+ * The nVHE hyp-VA is a *tagged* __kern_hyp_va() transform (NOT hyp_physvirt_offset,
+ * which is the hyp-VA<->phys relation). It is only a constant offset *within* the
+ * contiguous hyp .text, so a single anchor reverses PCs in that range and a range
+ * check is mandatory. The runtime base is kern_hyp_va(lm_alias(__hyp_text_start))
+ * (matching hyp_events.c): lm_alias() is required because __hyp_text_start is a
+ * kernel-image symbol while __kern_hyp_va() expects the linear-map alias of the
+ * same physical page.
+ *
+ * Prerequisite: CONFIG_RANDOMIZE_BASE=n (enforced by Kconfig), so the returned
+ * link address matches the offline vmlinux. Returns 0 for a PC outside the hyp
+ * text (caller drops it).
+ */
+unsigned long pkvm_cov_runtime_to_link(unsigned long pc)
+{
+	unsigned long link_start = (unsigned long)__hyp_text_start;
+	unsigned long hyp_start  = (unsigned long)kern_hyp_va(lm_alias((unsigned long)__hyp_text_start));
+	unsigned long text_size  = (unsigned long)__hyp_text_end - (unsigned long)__hyp_text_start;
+
+	if (pc < hyp_start || pc - hyp_start >= text_size)
+		return 0;
+	return link_start + (pc - hyp_start);
+}
+
+/* ---- multi-page / single-CPU host buffer state ---- */
+
+static DEFINE_MUTEX(pkvm_cov_lock);	/* serializes enable/disable */
+/*
+ * RCU-protected so the lockless #23 readers (pkvm_cov_begin/end) can never race a
+ * concurrent disable() into a use-after-free. begin()/end() run under
+ * kvm->mmu_lock (preemption off on a non-RT kernel = an RCU read-side section);
+ * disable() publishes NULL then synchronize_rcu() before it may free the pages.
+ */
+static struct pkvm_cov_ring __rcu *pkvm_cov_host_ring;	/* host linear-map vaddr, or NULL */
+static int pkvm_cov_owner_cpu = -1;	/* CPU whose EL2 buffer this is */
+static u32 pkvm_cov_nr_pages = PKVM_COV_DEFAULT_PAGES;	/* size for the NEXT enable() */
+/*
+ * Pages we have ATTEMPTED to share with the hyp, not pages successfully shared.
+ * share_pfn_hyp() inserts the host rb-tree record BEFORE the EL2 hypercall and
+ * does not roll it back if that call fails, so a page whose share returned an
+ * error may still be recorded and/or mapped. Cleanup must therefore cover
+ * [0, attempted), not [0, succeeded).
+ */
+static u32 pkvm_cov_attempted_pages;
+
+/*
+ * TEST-ONLY fault injection, so the leak-if-unconfirmed paths can actually be
+ * exercised on hardware instead of only being read. Default 0; debugfs-writable
+ * on a fuzzing kernel (this whole file is CONFIG_PKVM_EL2_COV). Each bit is
+ * consumed once, then cleared, so a single write arms exactly one failure.
+ *
+ * Note the asymmetry, which is deliberate. Bits 0 and 1 fake a failure AFTER the
+ * real operation succeeded; that is safe because the branch they select only
+ * ever LEAKS, so the worst case is 16 KiB wasted. Bit 2 selects a branch that
+ * can FREE, so it must not fake anything: it provokes a real EL2-side rejection
+ * before the hypervisor has registered the buffer.
+ */
+#define PKVM_COV_FI_TEARDOWN_HYP	(1u << 0)	/* pretend __pkvm_cov_setup(0) failed */
+#define PKVM_COV_FI_UNSHARE		(1u << 1)	/* pretend the unshare was unconfirmed */
+#define PKVM_COV_FI_ENABLE_SETUP	(1u << 2)	/* make EL2 genuinely REJECT the setup */
+static u32 pkvm_cov_fault_inject;
+
+static bool pkvm_cov_fi_take(u32 bit)
+{
+	if (!(pkvm_cov_fault_inject & bit))
+		return false;
+	pkvm_cov_fault_inject &= ~bit;	/* one-shot; caller holds pkvm_cov_lock */
+	return true;
+}
+
+/* ---- Step 1B: cumulative, exportable loss accounting ---------------------
+ *
+ * dmesg cannot answer "how much coverage did we lose": pr_warn_ratelimited both
+ * undercounts (it is rate limited) and, on a board with a serial console, costs
+ * ~100k KCOV entries per line because pl011_console_write busy-polls the UART
+ * inside the very call we are measuring. So the bridge no longer prints per-#23;
+ * it counts, and debugfs exports the totals.
+ *
+ * All updates happen in pkvm_cov_end() under kvm->mmu_lock with preemption off
+ * on the single owner CPU, so they are effectively serialized. The debugfs
+ * reader races them; that is fine for statistics, and READ_ONCE/WRITE_ONCE keeps
+ * the compiler from tearing or refetching.
+ */
+#define PKVM_COV_HIST_BUCKETS 16	/* bucket i == per-#23 hit counts in [2^(i-1), 2^i) */
+
+static struct pkvm_cov_gstats {
+	u64 begin_calls;	/* pkvm_cov_begin() entries with a live ring */
+	u64 skip_not_owner;	/* ... skipped: wrong CPU */
+	u64 skip_no_kcov;	/* ... skipped: task not collecting trace-pc */
+	u64 drains;		/* pkvm_cov_end() calls (== armed #23 windows) */
+	u64 hits;		/* EL2 SanCov callbacks entered while armed */
+	u64 written;		/* EL2 PCs that fit in the ring */
+	u64 dropped_ring;	/* EL2 PCs discarded: ring already full */
+	u64 nested;		/* EL2 callbacks discarded by the recursion guard */
+	u64 overflows;		/* #23 windows that hit the ring cap */
+	u64 link_ok;		/* runtime->link conversions that landed in hyp .text */
+	u64 link_drop;		/* ... and those that did not (dropped) */
+	u64 kcov_requested;	/* link PCs handed to kcov_add_pcs() */
+	u64 kcov_accepted;	/* ... actually stored */
+	u64 kcov_mode_lost;	/* batches rejected: task left trace-pc mid-drain */
+	u32 hits_max;		/* per-#23 raw callback high-water */
+	u32 written_max;	/* per-#23 delivered high-water */
+	u64 leaked_bytes;	/* buffer bytes deliberately not freed (unconfirmed teardown) */
+	u64 hits_hist[PKVM_COV_HIST_BUCKETS];
+} pkvm_cov_gstats;
+
+static void pkvm_cov_stats_reset(void)
+{
+	memset(&pkvm_cov_gstats, 0, sizeof(pkvm_cov_gstats));
+}
+
+/* IPI body: tear down the EL2 buffer on the owner CPU (pfn == 0), capturing the result. */
+struct pkvm_cov_teardown { int ret; };
+static void pkvm_cov_hyp_teardown_ipi(void *arg)
+{
+	struct pkvm_cov_teardown *t = arg;
+
+	t->ret = kvm_call_hyp_nvhe(__pkvm_cov_setup, 0, 0);
+}
+
+/*
+ * Undo the host->hyp share for every page we ATTEMPTED to share, and free the
+ * block only if every one of those unshares was confirmed.
+ *
+ * kvm_unshare_hyp_checked() attempts the whole range and returns the first
+ * error, so one bad page cannot leave later pages shared. If anything is
+ * unconfirmed we leak the ENTIRE order-N block rather than freeing part of it:
+ * the pages are physically contiguous and were handed to the hyp as one range,
+ * so returning any of them to the page allocator while the hyp may still map a
+ * neighbour is exactly the ownership violation we are trying to avoid.
+ */
+static void pkvm_cov_release_pages(struct pkvm_cov_ring *ring, u32 nr_pages,
+				   u32 attempted, const char *what)
+{
+	size_t bytes = (size_t)nr_pages * PAGE_SIZE;
+	int ret = 0;
+
+	if (attempted)
+		ret = kvm_unshare_hyp_checked(ring, (char *)ring + attempted * PAGE_SIZE);
+	if (!ret && pkvm_cov_fi_take(PKVM_COV_FI_UNSHARE)) {
+		ret = -EIO;
+		pr_warn("pkvm_cov: FAULT INJECTION — treating unshare as unconfirmed\n");
+	}
+	if (ret) {
+		pkvm_cov_gstats.leaked_bytes += bytes;
+		pr_warn("pkvm_cov: %s — unshare unconfirmed (%d) over %u/%u pages, LEAKING the whole %zu-byte block (EL2 may still map it)\n",
+			what, ret, attempted, nr_pages, bytes);
+		return;
+	}
+	free_pages((unsigned long)ring, get_order(bytes));
+}
+
+/*
+ * Allocate the shared ring, kvm_share_hyp() it (public API — keeps host page
+ * refcounts correct, unlike a raw __pkvm_host_share_hyp), and register it as this
+ * CPU's EL2 ring. The caller must be pinned to the intended owner CPU; that CPU
+ * is recorded and enforced at drain time.
+ */
+static int pkvm_cov_enable(void)
+{
+	struct pkvm_cov_ring *ring;
+	unsigned long pages;
+	u32 nr_pages, hcall_pages, attempted = 0, i;
+	size_t bytes;
+	int cpu, ret;
+
+	mutex_lock(&pkvm_cov_lock);
+	if (pkvm_cov_host_ring) {
+		ret = -EBUSY;
+		goto out;
+	}
+	nr_pages = pkvm_cov_nr_pages;
+	bytes = (size_t)nr_pages * PAGE_SIZE;
+
+	/*
+	 * Physically contiguous low-end pages (not vmalloc): kvm_share_hyp() maps
+	 * into the hyp's fixed-offset region and walks a physical range, and the hyp
+	 * pins that range off a single PFN, so the buffer must be one order-N block.
+	 */
+	pages = __get_free_pages(GFP_KERNEL | __GFP_ZERO, get_order(bytes));
+	if (!pages) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	ring = (struct pkvm_cov_ring *)pages;
+	/*
+	 * Capacity is host-written once, here, before the buffer pointer is
+	 * published. The hyp does not read it (it derives its own bound from the
+	 * nr_pages it validated), so this field only ever tells the host's own
+	 * drain how far pcs[] runs.
+	 */
+	ring->capacity = pkvm_cov_capacity_for(nr_pages);
+
+	/*
+	 * Share one page at a time so `attempted` is exact. share_pfn_hyp() inserts
+	 * the host rb-tree record BEFORE the EL2 hypercall and does not roll it back
+	 * on failure, so the page whose share returned an error counts as attempted
+	 * too — hence the increment before the call, not after it.
+	 */
+	for (i = 0; i < nr_pages; i++) {
+		char *p = (char *)ring + i * PAGE_SIZE;
+
+		attempted = i + 1;
+		ret = kvm_share_hyp(p, p + PAGE_SIZE);
+		if (ret)
+			goto rollback;
+	}
+
+	/*
+	 * FI bit 2 provokes a REAL setup failure instead of faking one afterwards:
+	 * hand the hyp an nr_pages it must reject. EL2 validates the host-supplied
+	 * count before it pins anything and before it publishes its per-CPU
+	 * pointer, so the hypercall fails having done nothing at all, and the
+	 * rollback below is exactly the genuine "shared, never registered" path —
+	 * a checked unshare, with no possibility that EL2 still maps the block.
+	 *
+	 * Faking the failure after a SUCCESSFUL setup (what this used to do) was
+	 * unsafe: EL2 had already registered the buffer, and the compensating
+	 * teardown IPI's result was discarded. If that undo had failed, the
+	 * rollback's unshare could still be confirmed and the pages freed while the
+	 * hypervisor still mapped them. Worse, the test would have reported
+	 * leaked_bytes == 0 and looked like a pass either way.
+	 *
+	 * Decided outside the get_cpu() window so the printk is not issued with
+	 * preemption disabled.
+	 */
+	hcall_pages = nr_pages;
+	if (pkvm_cov_fi_take(PKVM_COV_FI_ENABLE_SETUP)) {
+		hcall_pages = PKVM_COV_MAX_PAGES + 1;	/* hyp rejects: > the bound */
+		pr_warn("pkvm_cov: FAULT INJECTION — asking EL2 to set up nr_pages=%u so it rejects the setup\n",
+			hcall_pages);
+	}
+
+	cpu = get_cpu();	/* pin to this CPU for the setup hypercall */
+	ret = kvm_call_hyp_nvhe(__pkvm_cov_setup, page_to_pfn(virt_to_page(ring)),
+				hcall_pages);
+	put_cpu();
+	if (ret)
+		goto rollback;
+
+	pkvm_cov_owner_cpu = cpu;
+	pkvm_cov_attempted_pages = attempted;
+	rcu_assign_pointer(pkvm_cov_host_ring, ring);	/* release: publishes the initialized buffer */
+	pr_info("pkvm_cov: buffer armed on CPU %d (%u pages, %u PC slots)\n",
+		cpu, nr_pages, ring->capacity);
+	ret = 0;
+	goto out;
+
+rollback:
+	/*
+	 * The share OR the EL2 setup failed. Undo every page we attempted, CHECKED
+	 * and range-complete, and only free when all of them are confirmed;
+	 * otherwise leak the whole block — never hand possibly-shared memory back to
+	 * the page allocator (UAF / ownership violation).
+	 */
+	pkvm_cov_release_pages(ring, nr_pages, attempted, "enable rollback");
+out:
+	mutex_unlock(&pkvm_cov_lock);
+	return ret;
+}
+
+/*
+ * Teardown as a full active-drain lifecycle, not just a NULL write:
+ *   1. disarm + publish NULL      -> new begin() bails
+ *   2. synchronize_rcu()          -> wait for in-flight begin()/end() to finish
+ *   3. __pkvm_cov_setup(0) on the owner CPU, CHECKED -> EL2 drops its pointer
+ *   4. only then unshare + free
+ * If step 3 cannot be confirmed (owner CPU offline, IPI failure, hyp error), EL2
+ * may still reference the page: keep it disabled and LEAK the page rather than
+ * free something the hypervisor can still touch.
+ */
+static void pkvm_cov_disable(void)
+{
+	struct pkvm_cov_ring *ring;
+	struct pkvm_cov_teardown td = { .ret = -EIO };
+	u32 attempted;
+	int owner, ipi;
+
+	mutex_lock(&pkvm_cov_lock);
+	ring = rcu_dereference_protected(pkvm_cov_host_ring,
+					 lockdep_is_held(&pkvm_cov_lock));
+	if (!ring)
+		goto out;
+	owner = pkvm_cov_owner_cpu;
+	attempted = pkvm_cov_attempted_pages;
+
+	/* 1. reject new batches. */
+	smp_store_release(&ring->flags, 0);		/* disarm the producer */
+	rcu_assign_pointer(pkvm_cov_host_ring, NULL);	/* new begin() sees NULL */
+	/* 2. wait for readers that already loaded the old pointer (preempt-off). */
+	synchronize_rcu();
+
+	/* 3. unregister EL2's per-CPU pointer on the owner CPU; must be confirmed. */
+	ipi = (owner < 0) ? -ENXIO
+			  : smp_call_function_single(owner, pkvm_cov_hyp_teardown_ipi, &td, 1);
+	if (!ipi && !td.ret && pkvm_cov_fi_take(PKVM_COV_FI_TEARDOWN_HYP)) {
+		td.ret = -EIO;
+		pr_warn("pkvm_cov: FAULT INJECTION — treating EL2 teardown as unconfirmed\n");
+	}
+	if (ipi || td.ret) {
+		pkvm_cov_gstats.leaked_bytes += (size_t)pkvm_cov_nr_pages * PAGE_SIZE;
+		pr_warn("pkvm_cov: teardown unconfirmed (ipi=%d hyp=%d) — LEAKING the whole %u-page block (EL2 may still map it)\n",
+			ipi, td.ret, pkvm_cov_nr_pages);
+		pkvm_cov_owner_cpu = -1;		/* stays disabled; block intentionally leaked */
+		pkvm_cov_attempted_pages = 0;
+		goto out;
+	}
+
+	/*
+	 * 4. Undo the host->hyp share over every attempted page, CHECKED and
+	 * range-complete; free only if all of them are confirmed, else leak the
+	 * whole block.
+	 */
+	pkvm_cov_release_pages(ring, pkvm_cov_nr_pages, attempted, "teardown");
+	pkvm_cov_owner_cpu = -1;
+	pkvm_cov_attempted_pages = 0;
+	/*
+	 * Summarise here rather than per-#23: this runs from the debugfs write,
+	 * long after the measured call, so the console cost cannot contaminate a
+	 * coverage sample. Full detail is in kvm/pkvm_cov/stats.
+	 */
+	pr_info("pkvm_cov: buffer disarmed (drains=%llu el2_hits=%llu written=%llu lost_in_ring=%llu overflow_drains=%llu kcov_acc=%llu/%llu)\n",
+		pkvm_cov_gstats.drains, pkvm_cov_gstats.hits,
+		pkvm_cov_gstats.written,
+		pkvm_cov_gstats.hits > pkvm_cov_gstats.written
+			? pkvm_cov_gstats.hits - pkvm_cov_gstats.written : 0,
+		pkvm_cov_gstats.overflows,
+		pkvm_cov_gstats.kcov_accepted, pkvm_cov_gstats.kcov_requested);
+out:
+	mutex_unlock(&pkvm_cov_lock);
+}
+
+/*
+ * #23 drain, part 1 — called just before pkvm_host_map_guest() with kvm->mmu_lock
+ * held (preemption off, so smp_processor_id() is stable and this is an RCU
+ * read-side section). Arm the ring only when this is the owner CPU AND the
+ * faulting task is collecting KCOV trace-pc; else skip (coverage is optional,
+ * never wrong). Returns the armed ring for pkvm_cov_end(), or NULL. Cheap: no
+ * alloc, no sleep. The returned pointer stays valid until end() because
+ * disable()'s free waits on synchronize_rcu() for this preempt-off section.
+ */
+bool pkvm_cov_begin(struct pkvm_cov_ctx *ctx)
+{
+	/* preempt-off under mmu_lock is the RCU read-side; suppresses the lockdep check. */
+	struct pkvm_cov_ring *ring =
+		rcu_dereference_check(pkvm_cov_host_ring, !preemptible());
+
+	if (!ring)
+		return false;
+	WRITE_ONCE(pkvm_cov_gstats.begin_calls, pkvm_cov_gstats.begin_calls + 1);
+	if (smp_processor_id() != READ_ONCE(pkvm_cov_owner_cpu)) {
+		/* Counted, not printed: a printk here lands inside the measured call. */
+		WRITE_ONCE(pkvm_cov_gstats.skip_not_owner,
+			   pkvm_cov_gstats.skip_not_owner + 1);
+		return false;
+	}
+	if (!kcov_current_trace_pc()) {
+		WRITE_ONCE(pkvm_cov_gstats.skip_no_kcov,
+			   pkvm_cov_gstats.skip_no_kcov + 1);
+		return false;
+	}
+
+	/* Zero the per-#23 producer counters before publishing ENABLED, so every
+	 * increment the hyp makes belongs to this window and this window only. */
+	WRITE_ONCE(ring->count, 0);
+	WRITE_ONCE(ring->hits, 0);
+	WRITE_ONCE(ring->dropped, 0);
+	WRITE_ONCE(ring->nested, 0);
+	/*
+	 * Capacity travels with the buffer pointer: it is reached through `ring`,
+	 * so the address dependency orders it, and end() never has to re-read
+	 * global state that a concurrent disable() may already be changing. Read it
+	 * before arming, so the producer is not yet running when we do.
+	 */
+	ctx->ring = ring;
+	ctx->capacity = ring->capacity;
+
+	smp_store_release(&ring->flags, PKVM_COV_FLAG_ENABLED);
+	return true;
+}
+
+/*
+ * #23 drain, part 2 — called with the ring pkvm_cov_begin() returned, right after
+ * pkvm_host_map_guest() returns (on BOTH the success and error paths), still under
+ * mmu_lock. Disarm, then convert the EL2 runtime PCs to link addresses and append
+ * them to the faulting task's KCOV area. No alloc / no sleep; a bounded loop over
+ * at most the buffer capacity.
+ */
+void pkvm_cov_end(struct pkvm_cov_ctx *ctx)
+{
+	struct pkvm_cov_ring *ring = ctx->ring;
+	const u32 capacity = ctx->capacity;
+	u64 batch[64];
+	u32 i, count, flags, nb = 0;
+	u32 hits, dropped, nested, bucket;
+	u64 link_ok = 0, link_drop = 0, requested = 0, accepted = 0, mode_lost = 0;
+	bool overflow;
+
+	/* Acquire: pairs with the EL2 callback's release-set of OVERFLOW. */
+	flags = smp_load_acquire(&ring->flags);
+	smp_store_release(&ring->flags, 0);	/* disarm the producer */
+	/* Acquire: pair with the EL2 callback's smp_store_release(&count) so every
+	 * pcs[] entry published before `count` is visible here. */
+	count = smp_load_acquire(&ring->count);
+	/*
+	 * count == capacity is the AUTHORITATIVE truncation signal: it is
+	 * release/acquire-ordered, and the producer stops incrementing at the cap and
+	 * sets OVERFLOW. Treat it as overflow even if the (secondary) flag read raced.
+	 */
+	overflow = (count >= capacity) || (flags & PKVM_COV_FLAG_OVERFLOW);
+	if (count > capacity)
+		count = capacity;
+
+	/*
+	 * Producer-side counters, read after the acquire above. `hits` keeps
+	 * counting past the ring cap, so hits - count is exactly what this #23
+	 * window lost upstream -- the number no coverfile can ever show.
+	 */
+	hits    = READ_ONCE(ring->hits);
+	dropped = READ_ONCE(ring->dropped);
+	nested  = READ_ONCE(ring->nested);
+
+	for (i = 0; i < count; i++) {
+		unsigned long link = pkvm_cov_runtime_to_link((unsigned long)ring->pcs[i]);
+		int n;
+
+		if (!link) {
+			link_drop++;
+			continue;
+		}
+		link_ok++;
+		batch[nb++] = link;
+		if (nb == ARRAY_SIZE(batch)) {
+			n = kcov_add_pcs(batch, nb);
+			requested += nb;
+			if (n < 0)
+				mode_lost += nb;
+			else
+				accepted += n;
+			nb = 0;
+		}
+	}
+	if (nb) {
+		int n = kcov_add_pcs(batch, nb);
+
+		requested += nb;
+		if (n < 0)
+			mode_lost += nb;
+		else
+			accepted += n;
+	}
+
+	/* Accumulate. No printk on this path: see the pkvm_cov_gstats comment. */
+	WRITE_ONCE(pkvm_cov_gstats.drains,        pkvm_cov_gstats.drains + 1);
+	WRITE_ONCE(pkvm_cov_gstats.hits,          pkvm_cov_gstats.hits + hits);
+	WRITE_ONCE(pkvm_cov_gstats.written,       pkvm_cov_gstats.written + count);
+	WRITE_ONCE(pkvm_cov_gstats.dropped_ring,  pkvm_cov_gstats.dropped_ring + dropped);
+	WRITE_ONCE(pkvm_cov_gstats.nested,        pkvm_cov_gstats.nested + nested);
+	WRITE_ONCE(pkvm_cov_gstats.link_ok,       pkvm_cov_gstats.link_ok + link_ok);
+	WRITE_ONCE(pkvm_cov_gstats.link_drop,     pkvm_cov_gstats.link_drop + link_drop);
+	WRITE_ONCE(pkvm_cov_gstats.kcov_requested, pkvm_cov_gstats.kcov_requested + requested);
+	WRITE_ONCE(pkvm_cov_gstats.kcov_accepted,  pkvm_cov_gstats.kcov_accepted + accepted);
+	WRITE_ONCE(pkvm_cov_gstats.kcov_mode_lost, pkvm_cov_gstats.kcov_mode_lost + mode_lost);
+	if (overflow)
+		WRITE_ONCE(pkvm_cov_gstats.overflows, pkvm_cov_gstats.overflows + 1);
+	if (hits > READ_ONCE(pkvm_cov_gstats.hits_max))
+		WRITE_ONCE(pkvm_cov_gstats.hits_max, hits);
+	if (count > READ_ONCE(pkvm_cov_gstats.written_max))
+		WRITE_ONCE(pkvm_cov_gstats.written_max, count);
+	/* log2 buckets give the shape of the per-#23 demand without storing samples */
+	bucket = hits ? min_t(u32, PKVM_COV_HIST_BUCKETS - 1, fls(hits)) : 0;
+	WRITE_ONCE(pkvm_cov_gstats.hits_hist[bucket],
+		   pkvm_cov_gstats.hits_hist[bucket] + 1);
+}
+
+/* ---- debugfs control: kvm/pkvm_cov/{enable,owner_cpu} ---- */
+
+static int pkvm_cov_enable_set(void *data, u64 val)
+{
+	if (val)
+		return pkvm_cov_enable();
+	pkvm_cov_disable();
+	return 0;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(pkvm_cov_enable_fops, NULL, pkvm_cov_enable_set, "%llu\n");
+
+static int pkvm_cov_owner_get(void *data, u64 *val)
+{
+	*val = (u64)(s64)READ_ONCE(pkvm_cov_owner_cpu);
+	return 0;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(pkvm_cov_owner_fops, pkvm_cov_owner_get, NULL, "%lld\n");
+
+/*
+ * kvm/pkvm_cov/stats — the Step-1B data table. Cumulative since boot or since
+ * the last write to kvm/pkvm_cov/stats_reset. Every "lost" line below is a
+ * number that cannot be recovered from a coverfile, because it describes PCs
+ * that were discarded before they ever reached the KCOV area.
+ */
+static int pkvm_cov_stats_show(struct seq_file *s, void *unused)
+{
+	struct pkvm_cov_gstats g;
+	u64 lost_ring, lost_kcov;
+	int i;
+
+	/* one snapshot, so the derived numbers below are self-consistent */
+	memcpy(&g, &pkvm_cov_gstats, sizeof(g));
+	lost_ring = g.hits > g.written ? g.hits - g.written : 0;
+	lost_kcov = g.kcov_requested - g.kcov_accepted;
+
+	seq_printf(s, "ring_pages          %u\n", READ_ONCE(pkvm_cov_nr_pages));
+	seq_printf(s, "ring_capacity_pcs   %u\n",
+		   pkvm_cov_capacity_for(READ_ONCE(pkvm_cov_nr_pages)));
+	seq_printf(s, "owner_cpu           %d\n", READ_ONCE(pkvm_cov_owner_cpu));
+	seq_printf(s, "leaked_bytes        %llu\n", g.leaked_bytes);
+	seq_puts(s, "\n# arm/skip\n");
+	seq_printf(s, "begin_calls         %llu\n", g.begin_calls);
+	seq_printf(s, "skip_not_owner      %llu\n", g.skip_not_owner);
+	seq_printf(s, "skip_no_kcov        %llu\n", g.skip_no_kcov);
+	seq_printf(s, "drains              %llu\n", g.drains);
+	seq_puts(s, "\n# EL2 producer (per-#23, summed)\n");
+	seq_printf(s, "el2_hits            %llu\n", g.hits);
+	seq_printf(s, "el2_written         %llu\n", g.written);
+	seq_printf(s, "el2_dropped_ringful %llu\n", g.dropped_ring);
+	seq_printf(s, "el2_nested_dropped  %llu\n", g.nested);
+	seq_printf(s, "el2_overflow_drains %llu\n", g.overflows);
+	seq_printf(s, "el2_hits_max        %u\n", g.hits_max);
+	seq_printf(s, "el2_written_max     %u\n", g.written_max);
+	seq_printf(s, "LOST_IN_RING        %llu\n", lost_ring);
+	seq_puts(s, "\n# runtime->link conversion\n");
+	seq_printf(s, "link_ok             %llu\n", g.link_ok);
+	seq_printf(s, "link_dropped        %llu\n", g.link_drop);
+	seq_puts(s, "\n# task KCOV delivery\n");
+	seq_printf(s, "kcov_requested      %llu\n", g.kcov_requested);
+	seq_printf(s, "kcov_accepted       %llu\n", g.kcov_accepted);
+	seq_printf(s, "kcov_mode_lost      %llu\n", g.kcov_mode_lost);
+	seq_printf(s, "LOST_IN_KCOV_AREA   %llu\n", lost_kcov - g.kcov_mode_lost);
+	seq_puts(s, "\n# per-#23 hit distribution (log2 buckets)\n");
+	for (i = 0; i < PKVM_COV_HIST_BUCKETS; i++) {
+		if (!g.hits_hist[i])
+			continue;
+		if (i == 0)
+			seq_printf(s, "hits_0              %llu\n", g.hits_hist[i]);
+		else
+			seq_printf(s, "hits_%u_%u %llu\n", 1u << (i - 1),
+				   (1u << i) - 1, g.hits_hist[i]);
+	}
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(pkvm_cov_stats);
+
+static int pkvm_cov_stats_reset_set(void *data, u64 val)
+{
+	if (val)
+		pkvm_cov_stats_reset();
+	return 0;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(pkvm_cov_stats_reset_fops, NULL,
+			 pkvm_cov_stats_reset_set, "%llu\n");
+
+/*
+ * kvm/pkvm_cov/nr_pages — size of the buffer the NEXT enable() will allocate.
+ * Parameterised rather than hardcoded so a ring-capacity sweep needs no rebuild.
+ * Rejected while a buffer is live: the size is baked into the share range, the
+ * EL2 pin length and the producer's bound, so it can only change between
+ * lifecycles.
+ */
+static int pkvm_cov_nr_pages_get(void *data, u64 *val)
+{
+	*val = READ_ONCE(pkvm_cov_nr_pages);
+	return 0;
+}
+static int pkvm_cov_nr_pages_set(void *data, u64 val)
+{
+	int ret = 0;
+
+	if (!val || val > PKVM_COV_MAX_PAGES || (val & (val - 1)))
+		return -EINVAL;		/* power of two, within the EL2-enforced bound */
+	mutex_lock(&pkvm_cov_lock);
+	if (pkvm_cov_host_ring)
+		ret = -EBUSY;
+	else
+		pkvm_cov_nr_pages = val;
+	mutex_unlock(&pkvm_cov_lock);
+	return ret;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(pkvm_cov_nr_pages_fops, pkvm_cov_nr_pages_get,
+			 pkvm_cov_nr_pages_set, "%llu\n");
+
+/*
+ * kvm/pkvm_cov/fault_inject — TEST ONLY. Arms a one-shot failure so the
+ * leak-if-unconfirmed branches can be exercised on real hardware instead of only
+ * being reasoned about. Bit 0: EL2 teardown reports failure. Bit 1: the unshare
+ * is treated as unconfirmed. Bit 2: the enable-time EL2 setup reports failure.
+ * Each bit is consumed by the first branch that reads it.
+ */
+static int pkvm_cov_fi_get(void *data, u64 *val)
+{
+	*val = READ_ONCE(pkvm_cov_fault_inject);
+	return 0;
+}
+static int pkvm_cov_fi_set(void *data, u64 val)
+{
+	if (val & ~(u64)(PKVM_COV_FI_TEARDOWN_HYP | PKVM_COV_FI_UNSHARE |
+			 PKVM_COV_FI_ENABLE_SETUP))
+		return -EINVAL;
+	mutex_lock(&pkvm_cov_lock);
+	pkvm_cov_fault_inject = val;
+	mutex_unlock(&pkvm_cov_lock);
+	return 0;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(pkvm_cov_fi_fops, pkvm_cov_fi_get, pkvm_cov_fi_set, "%llu\n");
+
+static int __init pkvm_cov_debugfs_init(void)
+{
+	struct dentry *dir;
+
+	if (!kvm_debugfs_dir || IS_ERR(kvm_debugfs_dir))
+		return 0;
+	dir = debugfs_create_dir("pkvm_cov", kvm_debugfs_dir);
+	debugfs_create_file("enable", 0200, dir, NULL, &pkvm_cov_enable_fops);
+	debugfs_create_file("owner_cpu", 0400, dir, NULL, &pkvm_cov_owner_fops);
+	debugfs_create_file("stats", 0400, dir, NULL, &pkvm_cov_stats_fops);
+	debugfs_create_file("stats_reset", 0200, dir, NULL, &pkvm_cov_stats_reset_fops);
+	debugfs_create_file("nr_pages", 0600, dir, NULL, &pkvm_cov_nr_pages_fops);
+	debugfs_create_file("fault_inject", 0600, dir, NULL, &pkvm_cov_fi_fops);
+	return 0;
+}
+late_initcall(pkvm_cov_debugfs_init);
