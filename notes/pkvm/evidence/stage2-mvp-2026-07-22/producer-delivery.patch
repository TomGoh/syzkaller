+/*
+ * Append externally-collected PCs (e.g. pKVM EL2 hyp coverage drained around a
+ * hypercall boundary) into the current task's KCOV area.  Uses the same
+ * re-entrancy-safe order as __sanitizer_cov_trace_pc (publish count, barrier,
+ * then the PC).  The PCs are stored raw (hyp-VAs); the userspace consumer is
+ * responsible for the EL2 hyp-VA -> link-address mapping.  No canonicalize_ip():
+ * these are not kernel-text KASLR addresses.
+ */
+void notrace kcov_add_pcs(const u64 *pcs, u32 n)
+{
+	struct task_struct *t = current;
+	unsigned long *area;
+	unsigned long pos;
+	u32 i;
+
+	if (!check_kcov_mode(KCOV_MODE_TRACE_PC, t))
+		return;
+	area = t->kcov_area;
+	for (i = 0; i < n; i++) {
+		pos = READ_ONCE(area[0]) + 1;
+		if (pos >= t->kcov_size)
+			break;
+		WRITE_ONCE(area[0], pos);
+		barrier();
+		area[pos] = (unsigned long)pcs[i];
+	}
+}
+EXPORT_SYMBOL(kcov_add_pcs);
