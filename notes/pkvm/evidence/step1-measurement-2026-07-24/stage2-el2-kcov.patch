diff --git a/arch/arm64/include/asm/kvm_pkvm_cov.h b/arch/arm64/include/asm/kvm_pkvm_cov.h
new file mode 100644
index 000000000000..7192d7a134a2
--- /dev/null
+++ b/arch/arm64/include/asm/kvm_pkvm_cov.h
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Stage-2 EL2 coverage — shared ring layout between the pKVM hyp (producer) and
+ * the host (consumer). Exactly one 4K page: 24-byte header + 509 * 8-byte PCs.
+ * The hyp's __sanitizer_cov_trace_pc appends EL2 hyp-VA PCs; the host drains
+ * them into the current task's KCOV area via kcov_add_pcs().
+ *
+ * LOSS ACCOUNTING (Step 1B). `count` alone cannot answer "how much did we lose":
+ * once the ring is full the producer stops incrementing it, so a full ring looks
+ * identical whether one PC or ten thousand were discarded. The header therefore
+ * also carries per-#23 producer counters (hits/dropped/nested) that keep counting
+ * past the truncation point. They cost two PC slots (511 -> 509, 0.4%).
+ *
+ * Deliberate deviation: the roadmap suggested a SEPARATE host-shared stats page.
+ * Folding the counters into the existing page instead keeps the share / EL2 pin /
+ * unregister / unshare / leak-if-unconfirmed lifecycle exactly as reviewed --
+ * that lifecycle is where every UAF risk in this feature has lived, and doubling
+ * it for six counters is a bad trade in a step whose entire purpose is to produce
+ * numbers we can trust. A multi-page ring (Step 2) gets a proper header anyway.
+ */
+#ifndef __ASM_KVM_PKVM_COV_H
+#define __ASM_KVM_PKVM_COV_H
+
+#include <linux/types.h>
+
+/* header (6 * u32 = 24B) + PKVM_COV_RING_PCS * u64 == PAGE_SIZE (4096). */
+#define PKVM_COV_RING_PCS 509
+
+/* flags: a single u32 (fix: a separate `enabled` field would push the struct over a page). */
+#define PKVM_COV_FLAG_ENABLED  (1u << 0)	/* host-set: collect on this CPU */
+#define PKVM_COV_FLAG_OVERFLOW (1u << 1)	/* hyp-set: ring filled, PCs dropped */
+
+struct pkvm_cov_ring {
+	__u32 count;			/* number of valid entries in pcs[] (hyp-written) */
+	__u32 flags;			/* PKVM_COV_FLAG_* */
+	/*
+	 * Per-#23 producer counters. Host zeroes them in pkvm_cov_begin() before
+	 * the release-set of ENABLED; hyp increments them; host snapshots them in
+	 * pkvm_cov_end() after its acquire-load of `count`.
+	 *
+	 * Publication: `hits` and `dropped` are written before the hyp's
+	 * release-store of `count` / `flags`, so the host's acquire loads expose
+	 * them. `nested` has no such pairing, and is instead published by the
+	 * EL2->EL1 ERET: the drain only ever runs on the ring's owner CPU (the
+	 * owner guard in pkvm_cov_begin() returns NULL otherwise), so producer and
+	 * consumer are the same PE and the exception return is a context
+	 * synchronization event. A future per-CPU / cross-CPU ring MUST replace
+	 * this with an explicit release.
+	 */
+	__u32 hits;			/* armed SanCov callbacks entered, this #23 */
+	__u32 dropped;			/* of those, discarded because the ring was full */
+	__u32 nested;			/* callbacks discarded by the recursion guard */
+	__u32 __reserved;
+	__u64 pcs[PKVM_COV_RING_PCS];	/* EL2 hyp-VA program counters */
+};
+
+/* The ring is shared/pinned as exactly one 4K page; lock the layout. */
+_Static_assert(sizeof(struct pkvm_cov_ring) == 4096,
+	       "struct pkvm_cov_ring must be exactly one 4K page");
+
+#ifndef __KVM_NVHE_HYPERVISOR__
+/*
+ * Host (EL1) drain side — arch/arm64/kvm/pkvm_cov.c. Not visible to the hyp build.
+ */
+unsigned long pkvm_cov_runtime_to_link(unsigned long pc);	/* runtime hyp-VA -> link addr, 0 if out of range */
+struct pkvm_cov_ring *pkvm_cov_begin(void);	/* #23 hook: arm iff owner CPU + KCOV active; returns ring or NULL */
+void pkvm_cov_end(struct pkvm_cov_ring *ring);	/* #23 hook: disarm, drain+convert PCs, kcov_add_pcs() */
+#endif
+
+#endif /* __ASM_KVM_PKVM_COV_H */
diff --git a/arch/arm64/kvm/Kconfig b/arch/arm64/kvm/Kconfig
index a1ca0a9aa7db..529209468f14 100644
--- a/arch/arm64/kvm/Kconfig
+++ b/arch/arm64/kvm/Kconfig
@@ -124,6 +124,32 @@ config XCORE_UNIT_TEST
 
 	  If unsure, say N.
 
+config PKVM_EL2_COV
+	bool "pKVM EL2 (Rust hyp) coverage for syzkaller (Stage-2 KCOV)"
+	depends on KVM && X1_RMS && KCOV
+	depends on !RANDOMIZE_BASE
+	depends on !PREEMPT_RT
+	default n
+	help
+	  Instrument the protected-KVM Rust hypervisor with SanCov trace-pc and
+	  build it with DWARF line info, so EL2 program counters can be drained
+	  around a host->hyp boundary into the fuzzer task's KCOV area and
+	  symbolized to Rust source. This is a fuzzing/debug option only; it grows
+	  the hyp image and adds a per-basic-block callback. It never changes any
+	  existing hypercall id (its own id is guarded and explicitly dispatched).
+
+	  Depends on !RANDOMIZE_BASE: the drain converts a runtime hyp PC to its
+	  vmlinux link address (pkvm_cov_runtime_to_link), which only equals the
+	  offline vmlinux address when KASLR is off. With KASLR on the recovered
+	  address would not symbolize against the offline vmlinux.
+
+	  Depends on !PREEMPT_RT: the drain's teardown treats the mmu_lock-held
+	  begin->end window as an RCU read-side section (preemption disabled). On
+	  PREEMPT_RT the rwlock is a sleeping lock and does not disable preemption,
+	  so that assumption — and the single-CPU owner stability — would not hold.
+
+	  If unsure, say N.
+
 config XCORE_STATS
 	bool "X Core stats support"
 	depends on KVM
