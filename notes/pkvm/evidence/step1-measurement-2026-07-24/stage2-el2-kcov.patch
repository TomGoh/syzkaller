+        // Stage-2 EL2 coverage setup: explicit dispatch BEFORE the fixed HOST_HCALL table, so it
+        // never occupies a table slot and never shifts any existing hypercall id (incl. unit-test).
+        #[cfg(CONFIG_PKVM_EL2_COV)]
+        if id == crate::bindings::__kvm_host_smccc_func___KVM_HOST_SMCCC_FUNC___pkvm_cov_setup as u64 {
