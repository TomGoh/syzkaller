diff --git a/kernel/kcov.c b/kernel/kcov.c
index f9ac2e9e460f..93814ca4af90 100644
--- a/kernel/kcov.c
+++ b/kernel/kcov.c
@@ -225,6 +225,57 @@ void notrace __sanitizer_cov_trace_pc(void)
 }
 EXPORT_SYMBOL(__sanitizer_cov_trace_pc);
 
+#ifdef CONFIG_PKVM_EL2_COV
+/*
+ * Append externally-collected PCs (pKVM EL2 hyp coverage drained around a
+ * hypercall boundary) into the current task's KCOV area.  Uses the same
+ * re-entrancy-safe order as __sanitizer_cov_trace_pc (publish count, barrier,
+ * then the PC).  The caller (the pKVM #23 hook) passes already-converted
+ * __kvm_nvhe_ *link* addresses (runtime hyp-VA -> link done on the drain side via
+ * the __hyp_text anchor), so no canonicalize_ip() here.  Gated by
+ * CONFIG_PKVM_EL2_COV so the symbol only exists for the fuzz kernel.
+ */
+int notrace kcov_add_pcs(const u64 *pcs, u32 n)
+{
+	struct task_struct *t = current;
+	unsigned long *area;
+	unsigned long pos;
+	u32 i;
+
+	/*
+	 * Returns the number of entries actually stored, or -ENODEV if the task is
+	 * no longer collecting trace-pc at all. The caller (the pKVM #23 drain)
+	 * needs to tell "the KCOV area filled up" apart from "the consumer went
+	 * away mid-drain": both silently lose coverage, but only the first is a
+	 * capacity problem. A short return (< n) means the area is full.
+	 */
+	if (!check_kcov_mode(KCOV_MODE_TRACE_PC, t))
+		return -ENODEV;
+	area = t->kcov_area;
+	for (i = 0; i < n; i++) {
+		pos = READ_ONCE(area[0]) + 1;
+		if (pos >= t->kcov_size)
+			break;
+		WRITE_ONCE(area[0], pos);
+		barrier();
+		area[pos] = (unsigned long)pcs[i];
+	}
+	return i;
+}
+EXPORT_SYMBOL(kcov_add_pcs);
+
+/*
+ * Report whether the current task is in trace-pc collection mode, reusing the
+ * exact gate __sanitizer_cov_trace_pc() uses. notrace so it is safe to call from
+ * the pKVM #23 hook without self-instrumentation; it neither records nor mutates.
+ */
+bool notrace kcov_current_trace_pc(void)
+{
+	return check_kcov_mode(KCOV_MODE_TRACE_PC, current);
+}
+EXPORT_SYMBOL(kcov_current_trace_pc);
+#endif /* CONFIG_PKVM_EL2_COV */
